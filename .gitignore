# Generated by xcodegen — regenerate with `xcodegen generate`, never commit.
*.xcodeproj/
*.xcworkspace/

# Info.plist files are generated from project.yml's `info.properties`.
Gabbro/Info.plist
GabbroWidgets/Info.plist

# Xcode
xcuserdata/
DerivedData/
build/
*.xcuserstate
*.xcscmblueprint

# Swift Package Manager
.build/
.swiftpm/
# Package.resolved IS committed — FluidAudio is pre-1.0 and the design turns on
# pinning it. project.yml pins the version; this pins the commit.

# macOS
.DS_Store

# Model weights — ~460 MB to 1.2 GB, fetched at runtime into Application Support.
# Never vendored.
*.mlmodelc/
*.mlpackage/
Models/

# Recordings and fixtures. Audio does not go in git.
*.wav
*.m4a
Fixtures/
